#!/bin/bash
# cmd-ntfy
# Version: 1.3.0
# Description: Wrapper script that runs any command and sends ntfy notifications on completion
# Usage: cmd-ntfy [-v|--verbose] [-t|--tty] [-n|--name <name>] <command> [arguments...]
# Example: cmd-ntfy rsync -av /source /dest
# Example: cmd-ntfy -v zpool status
# Example: cmd-ntfy -t syncoid -r tank0/enc vault/enc
# Example: cmd-ntfy -n "SCADA DB Backup" rsync -av /var/lib/mysql/ backup-host:/backups/scada/
#
# Changelog:
# 1.3.0 - Added -n/--name flag: sets a friendly service name shown in the
#         notification title instead of just the raw command name. Useful
#         when the same command (e.g. rsync) runs different jobs and you
#         need to tell them apart at a glance on mobile.
#         Changed default (non-verbose) output preview from "first 30
#         lines" to "last N lines" (default 10, override with
#         SUMMARY_LINES in /etc/cron-notify.conf) since command summaries
#         (rsync stats, zpool status conclusion, syncoid completion)
#         usually appear at the end of output, not the start. -v/--verbose
#         still shows full output as before.
# 1.2.0 - Fixed -t/--tty flag: was documented but never parsed (USE_TTY was
#         never set, so the whole TTY code path was dead). Added curl error
#         handling with local fallback log on send failure. Added config
#         validation warning. Added byte-size cap on notification body to
#         stay under ntfy's default 4096-byte message limit. Switched
#         hardcoded /usr/bin paths to rely on $PATH for cross-distro use.
# 1.1.0 - Added -t/--tty flag for pseudo-TTY support (progress bars in rsync/syncoid)
# 1.0.0 - Initial release with hostname support and 30-line output limit

VERSION="1.3.0"

# Max bytes for the notification body (ntfy's default server limit is 4096
# bytes total per message; leave headroom for title/emoji/formatting).
NTFY_MAX_BODY_BYTES=3500

# Local fallback log if a notification send fails (network down, server
# unreachable, etc.) - so failures aren't silent.
NTFY_FALLBACK_LOG="/var/log/cmd-ntfy-failed.log"

### SOURCE NOTIFICATION CONFIG
if [ -f /etc/cron-notify.conf ]; then
    source /etc/cron-notify.conf
else
    # Default values if config file doesn't exist
    # Example:
    # NTFY_SERVER="your-ntfy-server.com"
    # NTFY_TOPIC="your-topic"
    # NTFY_USER="your-username"  # if needed
    # NTFY_PASS="your-password"  # if needed
    NTFY_SERVER=""
    NTFY_TOPIC=""
    NTFY_USER=""
    NTFY_PASS=""
fi

if [ -z "$NTFY_SERVER" ] || [ -z "$NTFY_TOPIC" ]; then
    echo "Warning: NTFY_SERVER or NTFY_TOPIC is not set (check /etc/cron-notify.conf)." >&2
    echo "The wrapped command will still run, but notifications will fail." >&2
fi

# Number of lines to show in the notification body by default (most recent
# lines, since command summaries - rsync stats, zpool status conclusion,
# syncoid completion - usually appear at the end of output, not the start).
# Can be overridden by setting SUMMARY_LINES in /etc/cron-notify.conf.
# Full output is still available via -v/--verbose.
SUMMARY_LINES=${SUMMARY_LINES:-10}

# Rely on $PATH rather than hardcoding paths - keeps this working
# unmodified across Debian, Arch, etc. where install locations can differ.
curl=curl
date=date
hostname=hostname

# Get hostname
HOSTNAME=$($hostname)

# Parse options
VERBOSE=false
USE_TTY=false
SERVICE_NAME=""
while [[ $# -gt 0 ]]; do
    case $1 in
        -v|--verbose)
            VERBOSE=true
            shift
            ;;
        -t|--tty)
            USE_TTY=true
            shift
            ;;
        -n|--name)
            SERVICE_NAME="$2"
            shift 2
            ;;
        --version)
            echo "cmd-ntfy version $VERSION"
            exit 0
            ;;
        -h|--help)
            echo "cmd-ntfy v$VERSION - Command wrapper with ntfy notifications"
            echo ""
            echo "Usage: cmd-ntfy [OPTIONS] <command> [arguments...]"
            echo ""
            echo "Options:"
            echo "  -v, --verbose    Show all output (default: last $SUMMARY_LINES lines as summary)"
            echo "  -t, --tty        Use pseudo-TTY (preserves progress bars in rsync/syncoid)"
            echo "  -n, --name NAME  Friendly name shown in the notification title (default: command name)"
            echo "  --version        Show version information"
            echo "  -h, --help       Show this help message"
            echo ""
            echo "Examples:"
            echo "  cmd-ntfy rsync -av /source /dest"
            echo "  cmd-ntfy -v zpool status"
            echo "  cmd-ntfy -t syncoid -r tank0/enc vault/enc"
            echo "  cmd-ntfy -n \"SCADA DB Backup\" rsync -av /var/lib/mysql/ backup-host:/backups/scada/"
            echo ""
            echo "Configuration:"
            echo "  Create /etc/cron-notify.conf with:"
            echo "    NTFY_SERVER=\"your-ntfy-server.com\""
            echo "    NTFY_TOPIC=\"your-topic\""
            echo "    NTFY_USER=\"username\"  # optional"
            echo "    NTFY_PASS=\"password\"  # optional"
            echo "    SUMMARY_LINES=10        # optional, lines shown in non-verbose mode"
            exit 0
            ;;
        -*)
            echo "Unknown option: $1"
            echo "Use --help for usage information"
            exit 1
            ;;
        *)
            break
            ;;
    esac
done

# Function to send ntfy notifications
send_notification() {
    local title="$1"
    local message="$2"
    local priority="${3:-default}"
    local http_code
    local curl_status

    if [ -n "$NTFY_USER" ] && [ -n "$NTFY_PASS" ]; then
        http_code=$($curl -sS -o /dev/null -w "%{http_code}" \
              -u "$NTFY_USER:$NTFY_PASS" \
              -H "Title: $title" \
              -H "Priority: $priority" \
              -d "$message" \
              "$NTFY_SERVER/$NTFY_TOPIC")
        curl_status=$?
    else
        http_code=$($curl -sS -o /dev/null -w "%{http_code}" \
              -H "Title: $title" \
              -H "Priority: $priority" \
              -d "$message" \
              "$NTFY_SERVER/$NTFY_TOPIC")
        curl_status=$?
    fi

    if [ "$curl_status" -ne 0 ] || [ "$http_code" != "200" ]; then
        {
            echo "[$($date)] Failed to send notification (curl_status=$curl_status http_code=$http_code)"
            echo "  Title: $title"
            echo "  Message: $message"
        } >> "$NTFY_FALLBACK_LOG" 2>/dev/null
        echo "Warning: ntfy notification failed (http_code=$http_code) - logged to $NTFY_FALLBACK_LOG" >&2
    fi
}

# Function to get human-readable duration
get_duration() {
    local duration=$1
    local hours=$((duration / 3600))
    local minutes=$(((duration % 3600) / 60))
    local seconds=$((duration % 60))

    if [ $hours -gt 0 ]; then
        echo "${hours}h ${minutes}m ${seconds}s"
    elif [ $minutes -gt 0 ]; then
        echo "${minutes}m ${seconds}s"
    else
        echo "${seconds}s"
    fi
}

# Function to sanitize command for display (remove sensitive info if needed)
sanitize_command() {
    local cmd="$1"
    # Add any sanitization rules here if needed
    # For example, mask passwords: cmd=$(echo "$cmd" | sed 's/--password=[^ ]*/--password=****/g')
    echo "$cmd"
}

# Check if at least one argument is provided
if [ $# -eq 0 ]; then
    echo "cmd-ntfy v$VERSION - Command wrapper with ntfy notifications"
    echo ""
    echo "Usage: cmd-ntfy [OPTIONS] <command> [arguments...]"
    echo ""
    echo "Options:"
    echo "  -v, --verbose    Show all output (default: last $SUMMARY_LINES lines as summary)"
    echo "  -t, --tty        Use pseudo-TTY (preserves progress bars in rsync/syncoid)"
    echo "  -n, --name NAME  Friendly name shown in the notification title (default: command name)"
    echo "  --version        Show version information"
    echo "  -h, --help       Show this help message"
    echo ""
    echo "Examples:"
    echo "  cmd-ntfy rsync -av /source /dest"
    echo "  cmd-ntfy -v zpool status"
    echo "  cmd-ntfy -n \"SCADA DB Backup\" rsync -av /source /dest"
    exit 1
fi

# Capture the full command
FULL_COMMAND="$*"
COMMAND_NAME=$(basename "$1")

# Name shown in the notification title - the friendly -n/--name value if
# given, otherwise falls back to the raw command name as before.
DISPLAY_NAME="${SERVICE_NAME:-$COMMAND_NAME}"

# Record start time
START_TIME=$(date +%s)
START_TIME_HUMAN=$($date)

# Optional: Send start notification (uncomment if desired)
# SANITIZED_CMD=$(sanitize_command "$FULL_COMMAND")
# send_notification "🔄 Command Started: $DISPLAY_NAME" "Host: $HOSTNAME"$'\n'"Command: $SANITIZED_CMD"$'\n'"Started: $START_TIME_HUMAN"

# Execute the command and capture output and exit code
OUTPUT_FILE=$(mktemp)

if $USE_TTY; then
    # Check if script command is available
    if ! command -v script &> /dev/null; then
        echo "Warning: 'script' command not found. Falling back to standard mode."
        echo "Install 'util-linux' package for TTY support."
        USE_TTY=false
    fi
fi

if $USE_TTY; then
    # Use script command to create a pseudo-TTY for progress bars
    # Build command string with proper quoting to preserve arguments
    CMD_STRING=$(printf '%q ' "$@")

    # script outputs to both terminal AND file, so user sees real-time output
    # -q: quiet mode (no start/stop messages)
    # -c: run command
    # Note: output is already displayed to terminal by script
    script -q -c "$CMD_STRING" "$OUTPUT_FILE"
    EXIT_CODE=$?
else
    # Standard execution with tee (shows real-time output AND captures to file)
    "$@" 2>&1 | tee "$OUTPUT_FILE"
    EXIT_CODE=${PIPESTATUS[0]}
fi

# Record end time and calculate duration
END_TIME=$(date +%s)
END_TIME_HUMAN=$($date)
DURATION=$((END_TIME - START_TIME))
DURATION_HUMAN=$(get_duration $DURATION)

# Get the complete output and apply summary limit if not verbose
OUTPUT_RAW="$(cat "$OUTPUT_FILE")"
OUTPUT_SIZE=$(wc -c < "$OUTPUT_FILE")
OUTPUT_LINES=$(wc -l < "$OUTPUT_FILE")
OUTPUT_LABEL="📋 Output:"

if $VERBOSE; then
    # Verbose mode: show all output
    OUTPUT_PREVIEW="$OUTPUT_RAW"
    OUTPUT_NOTE=""
else
    # Summary mode: show the last N lines, since summaries/results from
    # rsync, zpool, syncoid, etc. typically appear at the end of output.
    OUTPUT_LABEL="📋 Summary:"
    if [ $OUTPUT_LINES -gt $SUMMARY_LINES ]; then
        OUTPUT_PREVIEW="$(tail -n "$SUMMARY_LINES" "$OUTPUT_FILE")"
        OUTPUT_NOTE="Showing last $SUMMARY_LINES lines (total: $OUTPUT_LINES lines, use -v for full output)"
    else
        OUTPUT_PREVIEW="$OUTPUT_RAW"
        OUTPUT_NOTE=""
    fi
fi

# Clean up temp file
rm "$OUTPUT_FILE"

# Sanitize command for notification
SANITIZED_CMD=$(sanitize_command "$FULL_COMMAND")

# Belt-and-suspenders: even after the line cap, a handful of very long
# lines (wide `zpool status -v`, verbose rsync paths, etc.) can still blow
# past ntfy's message size limit. Hard-cap the preview in bytes too.
OUTPUT_PREVIEW_BYTES=$(printf '%s' "$OUTPUT_PREVIEW" | wc -c)
if [ "$OUTPUT_PREVIEW_BYTES" -gt "$NTFY_MAX_BODY_BYTES" ]; then
    OUTPUT_PREVIEW=$(printf '%s' "$OUTPUT_PREVIEW" | head -c "$NTFY_MAX_BODY_BYTES")
    OUTPUT_NOTE="Output truncated to ${NTFY_MAX_BODY_BYTES} bytes (total: $OUTPUT_LINES lines / $OUTPUT_SIZE bytes, use -v for full output)"
fi

# Send notification based on exit code
if [ $EXIT_CODE -eq 0 ]; then
    # Success notification
    MESSAGE="🖥️ Host: $HOSTNAME
✅ Command: $SANITIZED_CMD
⏱️ Duration: $DURATION_HUMAN
🕒 Completed: $END_TIME_HUMAN"

    if [ -n "$OUTPUT_PREVIEW" ]; then
        MESSAGE="$MESSAGE

$OUTPUT_LABEL
$OUTPUT_PREVIEW"
    fi

    if [ -n "$OUTPUT_NOTE" ]; then
        MESSAGE="$MESSAGE

ℹ️ $OUTPUT_NOTE"
    fi

    send_notification "✅ $DISPLAY_NAME Completed on $HOSTNAME" "$MESSAGE"
else
    # Failure notification
    MESSAGE="🖥️ Host: $HOSTNAME
❌ Command: $SANITIZED_CMD
💥 Exit code: $EXIT_CODE
⏱️ Duration: $DURATION_HUMAN
🕒 Failed: $END_TIME_HUMAN"

    if [ -n "$OUTPUT_PREVIEW" ]; then
        MESSAGE="$MESSAGE

$OUTPUT_LABEL
$OUTPUT_PREVIEW"
    fi

    if [ -n "$OUTPUT_NOTE" ]; then
        MESSAGE="$MESSAGE

ℹ️ $OUTPUT_NOTE"
    fi

    send_notification "❌ $DISPLAY_NAME Failed on $HOSTNAME" "$MESSAGE" "high"
fi

# Exit with the same code as the wrapped command
exit $EXIT_CODE
